{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  "observability": {
    "enabled": false
  }
}
